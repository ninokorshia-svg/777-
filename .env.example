# Environment configuration example
# Cloudflare Worker / Google AI Studio environment variables

# Port for local dev server
PORT=3000

# Application environment ('development' | 'production')
NODE_ENV=production

# Cloudflare D1 Database binding is provided automatically in Cloudflare via wrangler.jsonc (env.DB)
# Optional teacher enrollment master key (if unset, teachers set their initial password upon first login)
TEACHER_ENROLLMENT_SECRET=

# Session expiration duration in hours (default: 72)
SESSION_EXPIRATION_HOURS=72
